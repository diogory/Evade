local function getRoot(model)
    if not model then return nil end

    return model:FindFirstChild("HumanoidRootPart")
        or model.PrimaryPart
        or model:FindFirstChild("Torso")
        or model:FindFirstChildWhichIsA("BasePart")
end

local function getPlayer(model)
    if not model then return nil end
    return Players:GetPlayerFromCharacter(model)
end

local function readState(instance,stateName)
    if not instance then return false end

    local attribute=instance:GetAttribute(stateName)

    if attribute==true then
        return true
    end

    if typeof(attribute)=="string" then
        local value=attribute:lower()

        if value=="true" or value==stateName:lower() then
            return true
        end
    end

    if typeof(attribute)=="number" and attribute~=0 then
        return true
    end

    local object=instance:FindFirstChild(stateName,true)

    if not object then
        return false
    end

    if object:IsA("BoolValue") then
        return object.Value
    end

    if object:IsA("NumberValue") or object:IsA("IntValue") then
        return object.Value~=0
    end

    if object:IsA("StringValue") then
        local value=object.Value:lower()

        return value=="true" or value==stateName:lower()
    end

    return false
end

local function isDead(model)
    if not model then return false end

    local humanoid=model:FindFirstChildOfClass("Humanoid")

    if humanoid and humanoid.Health<=0 then
        return true
    end

    return readState(model,"Dead")
end

local function isDownedOrDead(model)
    local player=getPlayer(model)

    if not player then
        return false
    end

    return readState(model,"Downed")
        or readState(player,"Downed")
        or isDead(model)
end

local function createMark(model)
    if not model or Marks[model] then return end

    local root=getRoot(model)

    if not root then
        return
    end

    local holder=Instance.new("BillboardGui")
    holder.Name="DIOESP"
    holder.Adornee=root
    holder.Size=UDim2.fromOffset(300,24)
    holder.StudsOffset=Vector3.new(0,3,0)
    holder.AlwaysOnTop=true
    holder.MaxDistance=10000
    holder.Parent=gui

    local label=Instance.new("TextLabel")
    label.Size=UDim2.fromScale(1,1)
    label.BackgroundTransparency=1
    label.Text=""
    label.TextSize=10
    label.TextScaled=false
    label.TextWrapped=false

    pcall(function()
        label.TextTruncate=Enum.TextTruncate.None
    end)

    label.Font=Enum.Font.GothamBold
    label.TextStrokeColor3=Color3.new(0,0,0)
    label.TextStrokeTransparency=0
    label.Parent=holder

    local highlight=Instance.new("Highlight")
    highlight.Name="DIOHighlight"
    highlight.Adornee=model
    highlight.FillTransparency=0.75
    highlight.OutlineTransparency=0
    highlight.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent=model

    Marks[model]={
        gui=holder,
        label=label,
        highlight=highlight
    }
end

local function removeMark(model)
    local mark=Marks[model]

    if not mark then
        return
    end

    if mark.gui then
        mark.gui:Destroy()
    end

    if mark.highlight then
        mark.highlight:Destroy()
    end

    Marks[model]=nil
end

local function addCandidate(model)
    if not model or not model:IsA("Model") then
        return
    end

    if getPlayer(model) then
        Candidates[model]=true
    end
end

local function removeCandidate(model)
    Candidates[model]=nil
    removeMark(model)
end

local function hookPlayer(player)
    if player==LocalPlayer then
        return
    end

    if PlayerLinks[player] then
        for _,connection in ipairs(PlayerLinks[player]) do
            connection:Disconnect()
        end
    end

    PlayerLinks[player]={}

    table.insert(
        PlayerLinks[player],
        player.CharacterAdded:Connect(function(character)
            addCandidate(character)
        end)
    )

    table.insert(
        PlayerLinks[player],
        player.CharacterRemoving:Connect(function(character)
            removeCandidate(character)
        end)
    )

    if player.Character then
        addCandidate(player.Character)
    end
end

for _,player in ipairs(Players:GetPlayers()) do
    hookPlayer(player)
end

Players.PlayerAdded:Connect(function(player)
    hookPlayer(player)
end)

Players.PlayerRemoving:Connect(function(player)
    if PlayerLinks[player] then
        for _,connection in ipairs(PlayerLinks[player]) do
            connection:Disconnect()
        end

        PlayerLinks[player]=nil
    end

    if player.Character then
        removeCandidate(player.Character)
    end
end)

local frames=0
local fpsTime=os.clock()
local lastFPS=0

RunService.RenderStepped:Connect(function()
    frames+=1

    local now=os.clock()

    if now-fpsTime>=1 then
        lastFPS=frames
        frames=0
        fpsTime=now
    end

    local ping=0

    pcall(function()
        ping=math.floor(LocalPlayer:GetNetworkPing()*1000)
    end)

    Stats.Text="FPS "..lastFPS.."  |  "..ping.." ms"
    StatsStroke.Color=Color3.fromHSV((now%5)/5,0.9,1)

    local localRoot=getRoot(LocalPlayer.Character)

    for model in pairs(Candidates) do
        if not model or not model.Parent or not getPlayer(model) then
            Candidates[model]=nil
            removeMark(model)
        end
    end

    for model in pairs(Candidates) do
        if not Marks[model] then
            createMark(model)
        end
    end

    for model,mark in pairs(Marks) do
        if not ESP or not model.Parent then
            mark.gui.Enabled=false
            mark.highlight.Enabled=false
            continue
        end

        local root=getRoot(model)
        local player=getPlayer(model)

        if not root or not player then
            mark.gui.Enabled=false
            mark.highlight.Enabled=false
            continue
        end

        mark.gui.Enabled=true
        mark.highlight.Enabled=true
        mark.gui.Adornee=root

        local distance=0

        if localRoot then
            distance=math.floor(
                (localRoot.Position-root.Position).Magnitude
            )
        end

        local downed=isDownedOrDead(model)

        mark.label.Text=player.DisplayName.." | "..distance.." studs"

        if downed then
            mark.label.TextColor3=Color3.new(1,1,1)
            mark.highlight.FillColor=Color3.new(1,1,1)
            mark.highlight.OutlineColor=Color3.new(1,1,1)
        else
            mark.label.TextColor3=Color3.fromRGB(70,150,255)
            mark.highlight.FillColor=Color3.fromRGB(70,150,255)
            mark.highlight.OutlineColor=Color3.fromRGB(70,150,255)
        end
    end
end)

